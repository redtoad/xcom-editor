{
    // Verwendet IntelliSense zum Ermitteln möglicher Attribute.
    // Zeigen Sie auf vorhandene Attribute, um die zugehörigen Beschreibungen anzuzeigen.
    // Weitere Informationen finden Sie unter https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch file",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${file}"
        },
        {
            "name": "editor",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/editor/",
            "args": ["-path", "${workspaceFolder}/GAME/"],
            "stopOnEntry": true,
            "presentation": {
                "hidden": false,
                "group": "tools",
                "order": 1
            }
        },
        {
            "name": "revive-solders GAME_1",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/examples/revive-soldiers/main.go",
            "args": ["-path", "${workspaceFolder}/GAME/GAME_1/"],
            "presentation": {
                "hidden": false,
                "group": "tools",
                "order": 1
            }
        },
        {
            "name": "world GAME_1",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/examples/world/main.go",
            "args": ["-path", "${workspaceFolder}/GAME/GAME_1/"],
            "presentation": {
                "hidden": false,
                "group": "tools",
                "order": 1
            }
        }
    ]
}