<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="savegame-editor"
        Arguments=""
        InstallLocation="C:\Program Files\Sebastian Rahlf\X-COM Savegame Editor">
    </Installer>
    <PackageInformation
        PackageName="X-COM Savegame Editor"
        PackageDisplayName="X-COM Savegame Editor"
        PublisherName="CN=Sebastian Rahlf"
        PublisherDisplayName="Sebastian Rahlf"
        Version="0.0.0.0"
        PackageDescription="Savegame editor for X-COM: UFO Defense">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="de.redtoad.xcom-savegame-editor"
                Description="Savegame editor for X-COM: UFO Defense"
                DisplayName="X-COM Savegame Editor"
                ExecutableName="savegame-editor"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>X-COM Savegame Editor</DisplayName>
            <PublisherDisplayName>Sebastian Rahlf</PublisherDisplayName>
            <Description>Savegame editor for X-COM: UFO Defense</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="savegame-editor.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
